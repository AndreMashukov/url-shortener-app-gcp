# Copy to terraform.tfvars (gitignored) and fill in real values.
project_id = "serverless-503308"
region     = "asia-southeast1"
env        = "dev"

artifact_registry_repo = "url-shortener-apps-dev"

app_bff_image       = "asia-southeast1-docker.pkg.dev/serverless-503308/url-shortener-apps-dev/app-bff:latest"
